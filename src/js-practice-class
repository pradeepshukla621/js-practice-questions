// ########### Inheritance

class Animal {
  constructor() {
    this.speak(); // Call speak when an Animal is created
  }

  speak() {
    console.log("Animal makes sound");
  }
}

class Dog extends Animal {
  bark() {
    console.log("Woof!");
  }
}

// Example usage:
const a = new Animal(); // Logs: Animal makes sound
const d = new Dog();    // Logs: Animal makes sound
d.bark();               // Logs: Woof!

    
    